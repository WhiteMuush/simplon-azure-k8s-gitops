# IDE
.idea/
.vscode/
*.iml

# Terraform: local working directory and provider binaries
**/.terraform/*
.terraformrc
terraform.rc

# Terraform: state files, always stored in the remote backend
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform.tfstate.lock.info

# Terraform: plan output, may contain secret values in clear text
*.tfplan
*.tfplan.*
plan.out
plan.json

# Terraform: crash logs
crash.log
crash.*.log

# Terraform: variable files, may contain credentials
*.tfvars
*.tfvars.json
!*.tfvars.example

# Terraform: local overrides, meant for one machine only
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform: CLI configuration with credentials
.terraform.d/

# Secrets and credentials
*.pem
*.key
*.pfx
.env
.env.*
kubeconfig
*.kubeconfig
azure.json

# OS
.DS_Store
Thumbs.db

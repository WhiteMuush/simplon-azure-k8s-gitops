# Copy to .env. Sourced by every script, never committed.

# GitLab account and a personal access token with the api scope. They
# authenticate Terraform against the GitLab-managed state.
export TF_HTTP_USERNAME=your-gitlab-username
export TF_HTTP_PASSWORD=glpat-xxxxxxxxxxxxxxxxxxxx

# Subscription the infrastructure is created in.
export TF_VAR_subscription_id=00000000-0000-0000-0000-000000000000
